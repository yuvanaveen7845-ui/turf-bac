# Friends Turf - Backend Production Environment Configuration Template

# Core Django Settings
SECRET_KEY=generate_a_secure_50_plus_char_random_secret_for_production
DEBUG=False
ALLOWED_HOSTS=friendsturf.com,api.friendsturf.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://friendsturf.com,http://localhost:5173

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=postgresql://postgres:Friendsturf%4012345@db.tsqskggpbikhgypablih.supabase.co:5432/postgres
DB_SSL_REQUIRE=true

# Google OAuth (Authentication)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://friendsturf.com/login
GOOGLE_ALLOWED_DOMAIN=

# Razorpay Payment Gateway (Real Gateway Credentials)
# Test mode keys start with rzp_test_, Production keys start with rzp_live_
RAZORPAY_KEY_ID=rzp_live_your_production_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_production_webhook_secret

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
