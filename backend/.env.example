# Friends Turf - Backend Production Environment Configuration Template

# Core Django Settings
SECRET_KEY=generate_a_secure_50_plus_char_random_secret_for_production
DEBUG=False
ALLOWED_HOSTS=friendsturf.com,api.friendsturf.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://friendsturf.com,http://localhost:5173

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=postgresql://postgres.tsqskggpbikhgypablih:Friendsturf%4012345@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DB_SSL_REQUIRE=true

# Google OAuth (Authentication)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://friendsturf.com/login
GOOGLE_ALLOWED_DOMAIN=

# Service Base URLs
# Local: BACKEND_URL=http://localhost:8000, FRONTEND_URL=http://localhost:5173
# Live:  BACKEND_URL=https://turf-bac.onrender.com, FRONTEND_URL=https://friendsturf.in
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Razorpay Payment Gateway (12-Factor Environment-Isolated Configuration)
# Local development: provide test keys starting with rzp_test_
# Production environment: provide live keys starting with rzp_live_ in host secret manager
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Optional custom callback override (default: {BACKEND_URL}/api/payments/razorpay/callback/)
RAZORPAY_CALLBACK_URL=


# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Django SMTP Email Configuration (e.g. Gmail / Brevo / SendGrid / Amazon SES)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Friends Turf <noreply@friendsturf.com>

